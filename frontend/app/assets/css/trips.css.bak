.app-shell.trips-shell{max-width:1040px;background:#fbfcfc}.trips-shell main{padding-bottom:32px}.trips-shell .app-bar{padding-inline:28px}.trips-page{padding:38px 32px 22px}.trips-heading{display:flex;justify-content:space-between;align-items:center;gap:20px;margin-bottom:30px}.trips-eyebrow{font-size:10px!important;font-weight:700;letter-spacing:.19em;color:#2387a5!important;margin:0 0 7px!important}.trips-heading h1{font-size:30px;letter-spacing:-.03em;margin:0;color:#1b3945}.trips-heading p{font-size:14px;color:#76888e;margin:8px 0 0}.trips-atlas-link{display:flex;align-items:center;gap:8px;font-size:12px;font-weight:600;min-height:44px;padding:0 13px;background:white;border:1px solid #dce8ed;border-radius:12px;white-space:nowrap;color:#456c7b}.trips-atlas-link svg{width:19px;height:19px}.trips-list{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:20px}.trip-choice{overflow:hidden;border:1px solid #dfe9ed;border-radius:18px;background:#fff;text-align:left;padding:0;width:100%;color:#24424e;box-shadow:0 8px 24px #183e4c04;transition:transform .22s ease,box-shadow .22s ease,border-color .22s ease}.trip-choice:hover{transform:translateY(-3px);box-shadow:0 14px 32px #183e4c0e;border-color:#b5dce9}.trip-choice:focus-visible{outline:3px solid #edb82e;outline-offset:4px}.trip-choice-current{border-color:#a8d6e6}.trip-choice-image{height:178px;position:relative;background:#edf4f6;overflow:hidden}.trip-choice-image:after{content:'';position:absolute;inset:50% 0 0;background:linear-gradient(transparent,#1536464a);pointer-events:none}.trip-choice-image img{height:100%;width:100%;object-fit:cover;transition:transform .35s ease}.trip-choice:hover .trip-choice-image img{transform:scale(1.025)}.trip-choice-status{position:absolute;top:13px;left:13px;z-index:1;background:#ffffffed;color:#526c72;font-size:10px;font-weight:600;border-radius:7px;padding:5px 9px}.trip-choice-status.upcoming{background:#ecf8ff;color:#0784af}.trip-choice-days{position:absolute;bottom:13px;right:15px;font-size:12px;color:#fff;z-index:1}.trip-choice-body{padding:21px}.trip-choice-date{font-size:10px;letter-spacing:.045em;color:#83969d}.trip-choice-body h2{font-size:19px;font-weight:700;letter-spacing:-.025em;margin:7px 0 9px}.trip-choice-body>p{font-size:12px;color:#7a8a90;line-height:1.7;margin:0;min-height:41px}.trip-choice-company{display:flex;align-items:center;gap:9px;margin-top:19px;min-height:30px;color:#71858e;font-size:11px}.trip-mini-avatars{display:flex;padding-left:3px;flex-shrink:0}.trip-mini-avatars i{display:grid;place-items:center;width:27px;height:27px;border:2px solid white;margin-left:-3px;background:#dceef4;border-radius:50%;color:#54788a;font-style:normal;font-size:10px}.trip-mini-avatars i:nth-child(2){background:#f2e9d7;color:#9b8048}.trip-mini-avatars i:nth-child(3){background:#e8e6f2;color:#8a78a2}.trip-choice-action{display:flex;align-items:center;justify-content:space-between;border-top:1px solid #edf2f4;margin-top:20px;padding-top:14px;font-size:12px;font-weight:600;color:#098eb7}.trip-choice-action svg{width:21px;height:21px}.trips-footnote{font-size:11px;text-align:center;color:#83949b;line-height:1.8;margin:28px auto 0;max-width:560px}.trip-context{display:flex;align-items:center;gap:8px;padding:9px 18px;border-bottom:1px solid #e7eef1;background:#fafcfd}.trip-context-back{width:30px;min-height:44px;display:grid;place-items:center;flex-shrink:0;color:#718790}.trip-context-back svg{width:18px;height:18px}.trip-context-name{display:flex;flex-direction:column;gap:3px;min-width:0}.trip-context-name>span{color:#86969d;font-size:9px;letter-spacing:.035em}.trip-context-name strong{font-size:13px;line-height:1.35;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;color:#31535e}.trip-context-change{margin-left:auto;min-height:44px;display:flex;align-items:center;justify-content:center;gap:4px;color:#33839e;font-size:11px;white-space:nowrap;padding:0 5px;flex-shrink:0}.trip-context-change svg{width:16px;height:16px}.trip-switch-hint{font-size:13px;color:#7b8d94;margin:3px 0 18px}.trip-switch-list{display:grid;gap:10px}.trip-switch-option{display:flex;align-items:center;gap:12px;border:1px solid #e1eaee;background:white;border-radius:13px;text-align:left;width:100%;padding:11px;color:#345764}.trip-switch-option.selected{background:#f1faff;border-color:#84cfe7}.trip-switch-option>img{width:58px;height:58px;border-radius:9px;object-fit:cover;flex-shrink:0}.trip-switch-option>span{display:flex;flex-direction:column;gap:6px;min-width:0}.trip-switch-option strong{font-size:14px}.trip-switch-option small{font-size:10px;color:#81939a}.trip-switch-option>svg{width:19px;height:19px;margin-left:auto;flex-shrink:0;color:#0c9ac4}.trip-selection-gate{padding:76px 22px 90px;text-align:center}.trip-gate-symbol{display:grid;place-items:center;width:68px;height:68px;border-radius:22px;background:#ecf7fc;color:#439cbb;margin:0 auto 21px}.trip-gate-symbol svg{width:31px;height:31px}.trip-selection-gate h1{font-size:22px;color:#234752;margin:0 0 13px}.trip-selection-gate p{font-size:14px;color:#78909a;line-height:1.9;margin-bottom:26px}.trip-selection-gate .primary{display:inline-flex;min-width:190px;align-items:center;justify-content:center}.trip-context-loading{padding:100px 20px;text-align:center;color:#7b9199;font-size:13px}
@media(max-width:800px) and (min-width:601px){.trips-page{padding:30px 22px}.trips-list{gap:12px}.trip-choice-body{padding:16px}.trip-choice-image{height:148px}.trip-choice-body h2{font-size:17px}.trip-choice-company{font-size:10px;gap:5px}.trip-mini-avatars i{width:22px;height:22px}}
@media(max-width:600px){.app-shell.trips-shell{max-width:480px}.trips-shell .app-bar{padding-inline:18px}.trips-page{padding:27px 20px 20px}.trips-heading{gap:10px;flex-wrap:wrap;margin-bottom:24px}.trips-heading h1{font-size:27px}.trips-heading p{font-size:12px;line-height:1.6}.trips-atlas-link{font-size:11px;padding-inline:10px}.trips-list{grid-template-columns:1fr;gap:20px}.trip-choice-image{height:174px}.trip-choice-body{padding:18px 20px}.trip-choice-body>p{min-height:0}.trip-choice-company{margin-top:14px}.trip-choice-action{margin-top:15px;padding-top:12px}.trips-footnote{text-align:left;margin-top:22px}.trip-context{padding-inline:12px;gap:6px}.trip-context-name strong{font-size:12px}.trip-context-change{font-size:10px}.trip-switch-option{gap:10px}.trip-switch-option strong{font-size:13px}}
@media(max-width:350px){.trips-page{padding-inline:16px}.trips-heading{display:block}.trips-atlas-link{width:max-content;margin-top:15px}.trip-context{padding-inline:8px}.trip-context-back{width:22px}.trip-context-name>span{font-size:8px}.trip-choice-image{height:150px}}
@media(prefers-reduced-motion:reduce){.trip-choice,.trip-choice-image img{transition:none}.trip-choice:hover,.trip-choice:hover .trip-choice-image img{transform:none}}
.trip-choice[data-trip="fuji"] .trip-choice-image img{height:200%;object-position:50% 0}.trip-choice:disabled{cursor:wait}
